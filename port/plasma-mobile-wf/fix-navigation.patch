 // Same bound as the eqs diagnostic IPC client; reject lengths before allocation.
 static constexpr qint64 maxMessageBytes = 1024 * 1024;
 
+// Both channels are byte streams; consume only a complete, bounded JSON frame.
+static bool readFrame(QLocalSocket *socket, QJsonDocument &message)
+{
+    if (socket->bytesAvailable() < 4)
+        return false;
+    const QByteArray header = socket->peek(4);
+    if (header.size() != 4) {
+        socket->abort();
+        return false;
+    }
+    const quint32 size = qFromLittleEndian<quint32>(header.constData());
+    if (size == 0 || size > maxMessageBytes) {
+        qWarning() << "Invalid Wayfire IPC frame length; disconnecting";
+        socket->abort();
+        return false;
+    }
+    if (socket->bytesAvailable() < 4 + qint64(size))
+        return false;
+    socket->read(4);
+    const QByteArray data = socket->read(size);
+    QJsonParseError error;
+    message = QJsonDocument::fromJson(data, &error);
+    if (data.size() != size || error.error != QJsonParseError::NoError ||
+        (!message.isObject() && !message.isArray())) {
+        qWarning() << "Invalid Wayfire IPC JSON; disconnecting";
+        socket->abort();
+        return false;
+    }
+    return true;
+}
+
+static void writeFrame(QLocalSocket *socket, const QJsonDocument &message)
+{
+    const QByteArray data = message.toJson(QJsonDocument::Compact);
+    QDataStream out(socket);
+    out.setVersion(QDataStream::Qt_6_7);
+    out.setByteOrder(QDataStream::LittleEndian);
+    out.writeBytes(data.constData(), data.size());
+}
+
+static bool isApplication(const QJsonObject &view)
+{
+    const int id = view.value("id").toInt(-1);
+    const auto pid = view.value("pid").toInteger(-1);
+    const auto app = view.value("app-id").toString();
+    return id > 0 && view.value("id").toDouble(-1) == id &&
+        pid > 0 && pid != QCoreApplication::applicationPid() &&
+        view.value("role") == "toplevel" && view.value("layer") == "workspace" &&
+        view.value("mapped").toBool() && !app.isEmpty() &&
+        app != "org.kde.polkit-kde-authentication-agent-1";
+}
