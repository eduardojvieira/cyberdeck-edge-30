+ScreenRotationUtil::ScreenRotationUtil(QObject *parent) : QObject(parent)
+{
+    m_path = qEnvironmentVariable("WAYFIRE_CONFIG_FILE");
+    if (m_path.isEmpty()) {
+        m_path = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation)
+            + QStringLiteral("/plasma-mobile-wf/wayfire.ini");
+    }
+    connect(&m_watcher, &QFileSystemWatcher::fileChanged, this, &ScreenRotationUtil::reload);
+    connect(&m_watcher, &QFileSystemWatcher::directoryChanged, this, &ScreenRotationUtil::reload);
+    m_watcher.addPath(QFileInfo(m_path).absolutePath());
+    reload();
+}
+
+void ScreenRotationUtil::reload()
+{
+    if (QFileInfo::exists(m_path) && !m_watcher.files().contains(m_path)) m_watcher.addPath(m_path);
+    QByteArray bytes;
+    bool locked = true;
+    IniOption lock, transform;
+    const bool available = readRotation(m_path, bytes, locked, lock, transform);
+    const bool enabled = available && !locked;
+    if (available != m_available) {
+        m_available = available;
+        Q_EMIT availableChanged();
+    }
+    if (enabled != m_enabled) {
+        m_enabled = enabled;
+        Q_EMIT autoScreenRotationEnabledChanged();
+    }
+}
