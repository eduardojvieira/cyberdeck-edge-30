+void replaceOption(QByteArray &bytes, const IniOption &option, const QByteArray &section,
+                   const QByteArray &key, const QByteArray &value)
+{
+    QByteArray replacement = key + " = " + value;
+    if (!option.found) {
+        replacement += '\n';
+        if (!option.section) replacement.prepend("\n[" + section + "]\n");
+        if (option.offset > 0 && bytes[option.offset - 1] != '\n') replacement.prepend('\n');
+    }
+    bytes.replace(option.offset, option.length, replacement);
+}
+
+bool readRotation(const QString &path, QByteArray &bytes, bool &locked,
+                  IniOption &lock, IniOption &transform)
+{
+    const QFileInfo info(path);
+    QFile file(path);
+    if (!info.isFile() || info.isSymLink() || !info.isWritable() || info.size() > 128 * 1024
+        || !file.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    bytes = file.read(128 * 1024 + 1);
+    if (file.error() != QFile::NoError || bytes.size() > 128 * 1024 || bytes.contains('\0')) {
+        return false;
+    }
+    if (!findOption(bytes, "autorotate-iio", "lock_rotation", lock)
+        || !findOption(bytes, "output:HWCOMPOSER-1", "transform", transform)) return false;
+    if (lock.found && lock.value != "true" && lock.value != "false") return false;
+    // This port has one native-portrait panel and no mirrored outputs.
+    if (transform.found && transform.value != "auto" && transform.value != "normal"
+        && transform.value != "90" && transform.value != "180" && transform.value != "270") return false;
+    locked = lock.value == "true"; // absent = autorotate-iio's default, false
+    return true;
+}
+
+QByteArray currentTransform()
+{
+    if (!qobject_cast<QGuiApplication *>(QCoreApplication::instance())) return {};
+    for (auto *screen : QGuiApplication::screens()) {
+        if (screen->name() != QStringLiteral("HWCOMPOSER-1")) continue;
+        // Inverse of QtWayland 6.8's toScreenOrientation() for eqs's portrait panel.
+        // This is the compositor's actual orientation, not the accelerometer.
+        switch (screen->orientation()) {
+        case Qt::PortraitOrientation: return "normal";
+        case Qt::InvertedLandscapeOrientation: return "90";
+        case Qt::InvertedPortraitOrientation: return "180";
+        case Qt::LandscapeOrientation: return "270";
+        default: return {};
+        }
+    }
+    return {};
+}
+}
