Subject: [PATCH] Package the eqs Workspace 6.7.5 candidate without KWin startup

Apply after Debian plasma-workspace_6.7.4-1.debian.tar.xz (SHA256
d5443ffba4932e1801f5703066a299ef3253b58d0d66f8d6ee36e010ca518852).
Keep Debian hardening and add the multiarch QCoro Core config location.
This complements upgrade-workspace-6.7.5.patch, not a stock package upgrade.

--- a/debian/changelog
+++ b/debian/changelog
@@ -1,3 +1,11 @@
+plasma-workspace (4:6.7.5-0+eqs1~pre1) rolling; urgency=medium
+
+  * Rebase the Droidian KDE_NO_KWIN classic session and splash support onto
+    upstream 6.7.5; preserve Wayfire as the compositor.
+  * Reuse Debian 6.7.4-1 packaging. Development candidate, not device validated.
+
+ -- eqs port maintainers <eqs-port@localhost>  Tue, 15 Sep 2026 12:30:00 +0000
+
 plasma-workspace (4:6.7.4-1) unstable; urgency=medium
 
   [ Aurélien COUDERC ]
--- a/debian/rules
+++ b/debian/rules
@@ -1,4 +1,6 @@
 #!/usr/bin/make -f
+
+include /usr/share/dpkg/architecture.mk
 
 export DEB_BUILD_MAINT_OPTIONS = hardening=+all
 
@@ -10,7 +12,8 @@
 		-DBUILD_TESTING=OFF \
 		-DWITH_X11=ON \
 		-DQT_QML_NO_CACHEGEN=ON \
-		-DCMAKE_BUILD_RPATH_USE_ORIGIN=ON
+		-DCMAKE_BUILD_RPATH_USE_ORIGIN=ON \
+		-DQCoro6Core_DIR=/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/QCoro6Core
 
 override_dh_auto_test:
 	# Disable auto tests at build time
