+// SPDX-FileCopyrightText: 2024 Alexander Rutz <arpio@droidian.org>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <QObject>
+#include <qqmlregistration.h>
+
+#include <QLocalSocket>
+#include <QDataStream>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QPointer>
+
+class WayfireIPC : public QObject
+{
+    Q_OBJECT
+    QML_SINGLETON
+    QML_ELEMENT
+    Q_PROPERTY(bool navigationEnabled READ navigationEnabled WRITE setNavigationEnabled NOTIFY navigationEnabledChanged)
+    Q_PROPERTY(bool hasActiveApp READ hasActiveApp NOTIFY activeAppChanged)
+    Q_PROPERTY(bool activeAppFullscreen READ activeAppFullscreen NOTIFY activeAppChanged)
+
+public:
+    WayfireIPC(QObject *parent = nullptr);
+    void setFullscreen(int viewId, bool state);
+    bool navigationEnabled() const { return m_navigationEnabled; }
+    void setNavigationEnabled(bool enabled);
+    bool hasActiveApp() const { return m_activeViewId > 0; }
+    bool activeAppFullscreen() const { return m_activeFullscreen; }
+    Q_INVOKABLE bool showHome();
+    Q_INVOKABLE bool showOverview();
+    Q_INVOKABLE bool closeActive();
+    
+Q_SIGNALS:
+    void viewMapped(QString appId);
+    void pwrKeyStateChanged(int state);
+    void idleTimout();
+    void navigationEnabledChanged();
+    void activeAppChanged();
+
+private Q_SLOTS:
+    void onReadData();
+
+private:
+    void sendMessage(QJsonDocument jsonDoc);
+    enum class NavigationAction { Home, Close };
+    bool navigate(NavigationAction action);
+    void setActiveView(const QJsonObject &view);
+
+    QLocalSocket *m_wfsocket = nullptr;
+    QPointer<QLocalSocket> m_navigationSocket;
+    bool m_navigationEnabled = false;
+    int m_activeViewId = -1;
+    bool m_activeFullscreen = false;
+};
