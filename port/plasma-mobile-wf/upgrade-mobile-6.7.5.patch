diff --git a/components/wayfireipcplugin/wayfireipc.cpp b/components/wayfireipcplugin/wayfireipc.cpp
new file mode 100644
index 00000000..746f237e
--- /dev/null
+++ b/components/wayfireipcplugin/wayfireipc.cpp
@@ -0,0 +1,246 @@
+// SPDX-FileCopyrightText: 2024 Alexander Rutz <arpio@droidian.org>
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <QDebug>
+#include <QtEndian>
+#include <QCoreApplication>
+#include <QJsonArray>
+#include <QTimer>
+
+#include "wayfireipc.h"
+
+// Same bound as the eqs diagnostic IPC client; reject lengths before allocation.
+static constexpr qint64 maxMessageBytes = 1024 * 1024;
+
+// Both channels are byte streams; consume only a complete, bounded JSON frame.
+static bool readFrame(QLocalSocket *socket, QJsonDocument &message)
+{
+    if (socket->bytesAvailable() < 4)
+        return false;
+    const QByteArray header = socket->peek(4);
+    if (header.size() != 4) {
+        socket->abort();
+        return false;
+    }
+    const quint32 size = qFromLittleEndian<quint32>(header.constData());
+    if (size == 0 || size > maxMessageBytes) {
+        qWarning() << "Invalid Wayfire IPC frame length; disconnecting";
+        socket->abort();
+        return false;
+    }
+    if (socket->bytesAvailable() < 4 + qint64(size))
+        return false;
+    socket->read(4);
+    const QByteArray data = socket->read(size);
+    QJsonParseError error;
+    message = QJsonDocument::fromJson(data, &error);
+    if (data.size() != size || error.error != QJsonParseError::NoError ||
+        (!message.isObject() && !message.isArray())) {
+        qWarning() << "Invalid Wayfire IPC JSON; disconnecting";
+        socket->abort();
+        return false;
+    }
+    return true;
+}
+
+static void writeFrame(QLocalSocket *socket, const QJsonDocument &message)
+{
+    const QByteArray data = message.toJson(QJsonDocument::Compact);
+    QDataStream out(socket);
+    out.setVersion(QDataStream::Qt_6_7);
+    out.setByteOrder(QDataStream::LittleEndian);
+    out.writeBytes(data.constData(), data.size());
+}
+
+static bool isApplication(const QJsonObject &view)
+{
+    const int id = view.value("id").toInt(-1);
+    const auto pid = view.value("pid").toInteger(-1);
+    const auto app = view.value("app-id").toString();
+    return id > 0 && view.value("id").toDouble(-1) == id &&
+        pid > 0 && pid != QCoreApplication::applicationPid() &&
+        view.value("role") == "toplevel" && view.value("layer") == "workspace" &&
+        view.value("mapped").toBool() && !app.isEmpty() &&
+        app != "org.kde.polkit-kde-authentication-agent-1";
+}
+
+WayfireIPC::WayfireIPC(QObject *parent)
+    : QObject{parent}
+{
+    m_wfsocket = new QLocalSocket(this);
+    m_wfsocket->setReadBufferSize(maxMessageBytes + 4);
+
+    connect(m_wfsocket, &QLocalSocket::readyRead, this, &WayfireIPC::onReadData);
+    connect(m_wfsocket, &QLocalSocket::disconnected, this, [this] { setActiveView({}); });
+
+    QString socket_str = qgetenv("WAYFIRE_SOCKET");
+
+    if (socket_str != "")
+        m_wfsocket->connectToServer(socket_str);
+    
+    if (m_wfsocket->waitForConnected(1000)){
+        QJsonObject watchRules { {"method", "window-rules/events/watch"}, };
+        QJsonObject watchPlamo { {"method", "plamo/watch"}, };
+        QJsonObject watchIdle { {"method", "idle/watch"}, };
+        QJsonDocument jsonDoc = QJsonDocument(watchRules);
+        sendMessage(jsonDoc);
+        jsonDoc = QJsonDocument(watchPlamo);
+        sendMessage(jsonDoc);
+        jsonDoc = QJsonDocument(watchIdle);
+        sendMessage(jsonDoc);
+        sendMessage(QJsonDocument(QJsonObject{{"method", "window-rules/get-focused-view"}}));
+
+        
+    }
+}
+
+void WayfireIPC::setFullscreen(int viewId, bool state)
+{
+    QJsonObject msgObj;
+    QJsonObject dataObj;
+    
+    dataObj["view_id"] = viewId;
+    dataObj["state"] = state;
+
+    msgObj["method"] = "wm-actions/set-fullscreen";
+    msgObj["data"] = dataObj;
+
+    QJsonDocument jsonDoc = QJsonDocument(msgObj);
+    sendMessage(jsonDoc);
+}
+
+void WayfireIPC::onReadData()
+{
+    // Qt sockets are byte streams. Leave an incomplete frame buffered until the
+    // next readyRead, and yield after a bounded batch so input/lock can progress.
+    for (int processed = 0; processed < 32; ++processed) {
+        QJsonDocument msg;
+        if (!readFrame(m_wfsocket, msg))
+            return;
+        if (!msg.isObject()) {
+            qWarning() << "Unexpected array on Wayfire event channel; disconnecting";
+            m_wfsocket->abort();
+            return;
+        }
+
+        QString event = msg.object().value("event").toString();
+        QString appId = msg.object().value("view").toObject().value("app-id").toString();
+        int viewId = msg.object().value("view").toObject().value("id").toInt();
+
+        if (event == "view-focused")
+            setActiveView(msg.object().value("view").toObject());
+        else if (event == "view-unmapped" && viewId == m_activeViewId)
+            setActiveView({});
+        else if (viewId == m_activeViewId &&
+                 (event == "view-geometry-changed" || event == "view-minimized" ||
+                  event == "view-tiled" || event == "view-fullscreen" || event == "view-fullscreened"))
+            setActiveView(msg.object().value("view").toObject());
+        else if (event.isEmpty() && msg.object().contains("info"))
+            setActiveView(msg.object().value("info").toObject());
+
+        if(event == "power-key-pressed"){
+            Q_EMIT pwrKeyStateChanged(1);
+        } else if(event == "power-key-released"){
+            Q_EMIT pwrKeyStateChanged(0);
+        } else if(event == "idle-timeout"){
+            Q_EMIT idleTimout();
+        } else if(event == "view-mapped" && appId != ""){
+            Q_EMIT viewMapped(appId);
+        } else if(event == "view-focused" && appId == "org.kde.polkit-kde-authentication-agent-1"){
+            setFullscreen(viewId, false);
+        }
+
+    }
+    QMetaObject::invokeMethod(this, "onReadData", Qt::QueuedConnection);
+}
+
+void WayfireIPC::sendMessage(QJsonDocument jsonDoc)
+{
+    writeFrame(m_wfsocket, jsonDoc);
+}
+
+void WayfireIPC::setActiveView(const QJsonObject &view)
+{
+    const int id = isApplication(view) && !view.value("minimized").toBool()
+        ? view.value("id").toInt() : -1;
+    const bool fullscreen = id > 0 && view.value("fullscreen").toBool();
+    if (id != m_activeViewId || fullscreen != m_activeFullscreen) {
+        m_activeViewId = id;
+        m_activeFullscreen = fullscreen;
+        Q_EMIT activeAppChanged();
+    }
+}
+
+void WayfireIPC::setNavigationEnabled(bool enabled)
+{
+    if (enabled == m_navigationEnabled)
+        return;
+    m_navigationEnabled = enabled;
+    if (!enabled && m_navigationSocket)
+        m_navigationSocket->abort();
+    Q_EMIT navigationEnabledChanged();
+}
+
+bool WayfireIPC::showHome() { return navigate(NavigationAction::Home); }
+bool WayfireIPC::closeActive() { return m_activeViewId > 0 && navigate(NavigationAction::Close); }
+
+bool WayfireIPC::showOverview()
+{
+    if (!m_navigationEnabled || m_navigationSocket || m_wfsocket->state() != QLocalSocket::ConnectedState)
+        return false;
+    sendMessage(QJsonDocument(QJsonObject{{"method", "scale/toggle_all"}}));
+    return true; // Request accepted, not proof that the compositor changed its view.
+}
+
+bool WayfireIPC::navigate(NavigationAction action)
+{
+    if (!m_navigationEnabled || m_navigationSocket || m_wfsocket->state() != QLocalSocket::ConnectedState)
+        return false;
+    // Isolate query replies/timeouts from the power/idle subscription. One
+    // bounded request at a time; never queue Close against an old focused view.
+    auto *socket = new QLocalSocket(this);
+    m_navigationSocket = socket;
+    socket->setReadBufferSize(maxMessageBytes + 4);
+    const auto finish = [this, socket] {
+        if (m_navigationSocket == socket)
+            m_navigationSocket = nullptr;
+        socket->deleteLater();
+    };
+    connect(socket, &QLocalSocket::disconnected, this, finish);
+    connect(socket, &QLocalSocket::errorOccurred, this, [finish](auto) { finish(); });
+    QTimer::singleShot(1500, socket, [socket, finish] { socket->abort(); finish(); });
+    connect(socket, &QLocalSocket::connected, this, [socket] {
+        writeFrame(socket, QJsonDocument(QJsonObject{{"method", "window-rules/list-views"}}));
+    });
+    const int requestedFocus = m_activeViewId;
+    connect(socket, &QLocalSocket::readyRead, this, [this, socket, action, requestedFocus] {
+        QJsonDocument reply;
+        if (!readFrame(socket, reply))
+            return;
+        if (!m_navigationEnabled || !reply.isArray() || reply.array().size() > 512) {
+            qWarning() << "Navigation denied or invalid Wayfire view snapshot";
+            socket->abort();
+            return;
+        }
+        disconnect(socket, &QLocalSocket::readyRead, this, nullptr);
+        // ponytail: one snapshot, capped at 512 views; no long-lived task model.
+        for (const auto &value : reply.array()) {
+            const auto view = value.toObject();
+            if (!isApplication(view) || view.value("minimized").toBool())
+                continue;
+            const int id = view.value("id").toInt();
+            if (action == NavigationAction::Close) {
+                if (id != requestedFocus || m_activeViewId != requestedFocus || !view.value("activated").toBool())
+                    continue;
+                writeFrame(socket, QJsonDocument(QJsonObject{{"method", "window-rules/close-view"},
+                    {"data", QJsonObject{{"id", id}}}}));
+                break;
+            }
+            writeFrame(socket, QJsonDocument(QJsonObject{{"method", "wm-actions/set-minimized"},
+                {"data", QJsonObject{{"view_id", id}, {"state", true}}}}));
+        }
+        socket->disconnectFromServer(); // Qt drains queued writes; no visual-success claim.
+    });
+    socket->connectToServer(m_wfsocket->serverName());
+    return true;
+}
