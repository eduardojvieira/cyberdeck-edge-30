# Core requirements for Droidian systemd 257, Halium and early diagnostics.
# https://docs.droidian.org/porting-guide/kernel-compilation/
# https://github.com/systemd/systemd/blob/v257/README
# Board drivers, binder integration and physical operation still need validation.
CONFIG_DEVTMPFS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_DM=y
CONFIG_EXT4_FS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_CFI_CLANG=y
# Chromium on Linux reads gamepad axes/buttons through /dev/input/js*.
CONFIG_INPUT_JOYDEV=y
# bluebinder requires VHCI; HID/UHID cover classic and LE input, BNEP covers PAN.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HCIVHCI=y
CONFIG_UHID=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
