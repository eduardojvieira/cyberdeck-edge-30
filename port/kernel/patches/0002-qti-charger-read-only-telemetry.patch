+/* Raw firmware fields, not a calibrated measurement at the USB connector. */
+static ssize_t switchedcap_snapshot_show(struct device *dev,
+					struct device_attribute *attr, char *buf)
+{
+	struct qti_charger *chg = dev_get_drvdata(dev);
+	struct switched_dev_info info = { 0 };
+	int rc, pos = 0;
+	u32 i;
+
+	BUILD_BUG_ON(sizeof(info) != 40);
+	if (!chg->switched_nums || chg->switched_nums > 2)
+		return -EOPNOTSUPP;
+	for (i = 0; i < chg->switched_nums; i++) {
+		rc = qti_charger_read(chg, OEM_PROP_MASTER_SWITCHEDCAP_INFO + i,
+				      &info, sizeof(info));
+		if (rc)
+			return rc;
+		/* Do not evaluate an invalid wire representation of C bool. */
+		if (((u8 *)&info)[0] > 1)
+			return -ENODATA;
+		pos += scnprintf(buf + pos, PAGE_SIZE - pos,
+			"raw=1 index=%u chg_en=%u role=%u mode=%u int_stat=%u "
+			"ibat_ma=%d ibus_ma=%d vbus_mv=%d vout_mv=%d vac_mv=%d "
+			"vbat_mv=%d vusb_mv=%d vwpc_mv=%d die_temp=%d\n",
+			i, info.chg_en, info.chg_role, info.work_mode, info.int_stat,
+			info.ibat_ma, info.ibus_ma, info.vbus_mv, info.vout_mv,
+			info.vac_mv, info.vbat_mv, info.vusb_mv, info.vwpc_mv,
+			info.die_temp);
+	}
+	return pos;
+}
+static struct device_attribute dev_attr_switchedcap_snapshot =
+	__ATTR(switchedcap_snapshot, 0400, switchedcap_snapshot_show, NULL);
 
