def run(command):
    print('\n$ ' + shlex.join(command), flush=True)
    result = subprocess.run(command, timeout=90,
                            env={**os.environ, 'PATH': TOOL_PATH, 'PAGER': 'cat', 'MANPAGER': 'cat'})
    if result.returncode not in (0, 124):
        print(f'La herramienta terminó con código {result.returncode}.')
    return result.returncode


def choose(rows, title, help_key=None):
    # Only used for the short interface prompt while Textual is suspended.
    print('\n' + title)
    for index, (_, label) in enumerate(rows, 1):
        print(f'  {index}. {label}')
    answer = input('Número (Enter cancela): ').strip()
    if not answer:
        return None
    if not answer.isdecimal() or not 1 <= int(answer) <= len(rows):
        raise ValueError('Elegí un número de la lista; no se ejecutó la captura.')
    return rows[int(answer) - 1][0]


def confirm(message):
    return input(message + '\nEscribí si para continuar (Enter cancela): ').strip().lower() in ('si', 'sí')


def target_ip():
    return str(ipaddress.ip_address(input('IP del equipo autorizado (no rangos): ').strip()))


def domain():
    name = input('Dominio (sin URL): ').strip().rstrip('.')
    if len(name) > 253 or not all(re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', part) for part in name.split('.')):
        raise ValueError('Dominio inválido; no se ejecutó la consulta.')
    return name


def input_file():
    path = Path(input('Ruta del archivo: ').strip()).expanduser().resolve(strict=True)
    if not path.is_file():
        raise ValueError('No es un archivo regular.')
    return str(path)


def action(key):
    if key in GUIDES:
        run(GUIDES[key][3])
    elif key == 'network':
        for cmd in (['ip', '-br', 'address'], ['ip', 'route'], ['nmcli', 'device', 'status']):
            run(cmd)
    elif key == 'listeners':
        run(['ss', '-lntup'])
    elif key == 'ping':
        run(['ping', '-c', '4', '-W', '2', target_ip()])
    elif key == 'dns':
        run(['dig', '+time=3', '+tries=1', domain()])
    elif key == 'http':
        name = domain()
        if confirm('Consultar https://' + name + '/. ¿Tenés permiso?'):
            run(['curl', '--head', '--connect-timeout', '5', '--max-time', '15', '--proto', '=https', '--url', 'https://' + name + '/'])
    elif key == 'neighbors':
        run(['ip', 'neigh', 'show'])
    elif key == 'route':
        ip = target_ip()
        if confirm('Trazar ruta a ' + ip + ', máximo 12 saltos. ¿Tenés permiso?'):
            run(['traceroute', '-6' if ':' in ip else '-4', '-n', '-q', '1', '-m', '12', '-w', '1', ip])
    elif key == 'subnet':
        net = ipaddress.ip_network(input('IP/prefijo: ').strip(), strict=False)
        print(f'Red: {net}\nMáscara: {net.netmask}\nRango completo: {net.network_address} – {net.broadcast_address}\nDirecciones totales (no hosts utilizables): {net.num_addresses}')
    elif key == 'ports':
        ip = target_ip()
        if confirm('Destino: ' + ip + '. Confirmá que tenés permiso y que es seguro escanearlo.'):
            command = ['nmap', '-sT', '-Pn', '--top-ports', '100', '--max-retries', '1', '--host-timeout', '30s', ip]
            if ':' in ip:
                command.insert(1, '-6')
            run(command)
    elif key == 'capture':
        iface = choose([(name, name) for _, name in socket.if_nameindex()], 'Interfaz', 'capture')
        if not iface or iface not in dict((name, index) for index, name in socket.if_nameindex()):
            return
        if confirm('Capturar tráfico de ' + iface + ' durante hasta 60 s. Puede contener datos privados. ¿Tenés permiso?'):
            folder = Path.home() / 'Documents/EQS-Capturas'
            folder.mkdir(parents=True, exist_ok=True, mode=0o700)
            folder.chmod(0o700)  # mkdir's mode does not protect an existing directory.
            fd, path = tempfile.mkstemp(prefix='eqs-', suffix='.pcap', dir=folder)
            os.close(fd)
            status = run(['sudo', 'timeout', '60', 'tcpdump', '-i', iface, '-nn', '-s', '128', '-c', '200', '-Z', getpass.getuser(), '-w', path])
            if status not in (0, 124):
                print('La captura falló; el archivo puede estar vacío o incompleto: ' + path)
                return
            print('Captura: ' + path + '\nVerla: tcpdump -nn -r ' + shlex.quote(path))
    elif key == 'wifi':
        run(['nmcli', 'device', 'wifi', 'list', '--rescan', 'no'])
    elif key == 'bluetooth':
        run(['bluetoothctl', 'show'])
        run(['bluetoothctl', 'devices', 'Paired'])
    elif key == 'usb':
        run(['lsusb'])
        run(['lsusb', '-t'])
        print('\nPuertos serie:')
        print('\n'.join(map(str, Path('/dev/serial/by-id').glob('*'))) or 'Sin puertos serie identificados.')
    elif key in ('hash', 'hex', 'pcap-info', 'pcap-read', 'filetype', 'elf', 'binary-info', 'metadata'):
        path = input_file()
        commands = {
            'hash': ['sha256sum', '--'], 'hex': ['od', '-Ax', '-tx1z', '-N', '4096', '--'],
            'pcap-info': ['capinfos', '-c', '-s', '-a', '-e', '-u'],
            'pcap-read': ['tshark', '-n', '-c', '100', '-r'],
            'filetype': ['file', '--'], 'elf': ['readelf', '-h', '--'],
            'binary-info': ['rabin2', '-I'], 'metadata': ['exiftool'],
        }
        run(commands[key] + [path])
    elif key == 'packages':
        run(['dpkg', '--audit'])
        run(['apt-mark', 'showhold'])
    elif key == 'firewall':
        run(['sudo', 'nft', 'list', 'ruleset'])
    elif key == 'inventory':
        programs = sorted({row[3][0] for row in GUIDES.values()} | {'ip', 'ss', 'ping', 'dig', 'tcpdump', 'curl', 'capinfos', 'tshark', 'file', 'readelf', 'rabin2', 'exiftool', 'nft', 'traceroute'})
        for program in programs:
            print(program + ': ' + (shutil.which(program, path=TOOL_PATH) or 'NO INSTALADO / fuera de PATH'))
    elif key in ('cyberchef', 'mqtt-explorer', 'convertall'):
        desktops = {'cyberchef': 'uk.gov.gchq.CyberChef.desktop', 'mqtt-explorer': 'mqtt-explorer.desktop', 'convertall': 'convertall.desktop'}
        launcher = Path.home() / '.local/share/applications' / desktops[key]
        run(['gio', 'launch', str(launcher)])
    elif key == 'guide':
        print(TOOLS[key][2])
    else:
        raise ValueError('Herramienta desconocida.')


def main():
    if len(sys.argv) > 1:
        if sys.argv[1] == '--help' and len(sys.argv) == 2:
            print(TOOLS['guide'][2])
            return 0
        if len(sys.argv) == 3 and sys.argv[1] == '--help' and sys.argv[2] in TOOLS:
            _, label, help_text = TOOLS[sys.argv[2]]
            print(label + '\n\n' + help_text)
            return 0
        print('Uso: eqs-hacking [--help [herramienta]]', file=sys.stderr)
        return 2
    if not sys.stdout.isatty():
        print('Abrí EQS Hacking Toolbox desde Plasma o una terminal.', file=sys.stderr)
        return 2
    try:
        from eqs_hacking_ui import ToolboxApp
    except ImportError:
        print('Falta la interfaz Textual. Instalá python3-textual y eqs_hacking_ui.py junto a eqs-hacking. Ver port/shell/TOOLBOX.md.', file=sys.stderr)
        return 2
    try:
        ToolboxApp(TOOLS, GUIDES, action).run()
    except (KeyboardInterrupt, EOFError):
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
