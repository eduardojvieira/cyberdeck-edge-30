#!/bin/sh
# Keep KiCad's Python/GTK/Mesa separate from the retained mobile stack.
unset LD_PRELOAD
export FLATPAK_GL_DRIVERS=default
# Droidian's flatpak-hybris wrapper loses quoted argv and injects vendor libs.
exec /usr/bin/flatpak.real run --env=LIBGL_ALWAYS_SOFTWARE=1 --env=GALLIUM_DRIVER=softpipe org.kicad.KiCad "$@"
