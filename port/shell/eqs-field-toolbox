def number(raw, *, low=None, high=None, positive=False, integer=False):
    if len(raw) > 64:
        raise ValueError('Número demasiado largo (máximo 64 caracteres).')
    try:
        exact = Decimal(raw.strip().replace(',', '.'))
    except InvalidOperation:
        raise ValueError('Ingresá un número, con coma o punto decimal y sin separador de miles.') from None
    if not exact.is_finite() or exact.copy_abs() > Decimal('1e100'):
        raise ValueError('Ingresá un número finito de magnitud no mayor que 1e100.')
    if positive and exact <= 0:
        raise ValueError('El valor debe ser mayor que cero.')
    if (low is not None and exact < low) or (high is not None and exact > high):
        raise ValueError(f'Valor fuera del intervalo permitido: {low} … {high}.')
    if integer:
        if exact != exact.to_integral_value() or exact.copy_abs() > 2**53 - 1:
            raise ValueError('Ingresá un entero exacto de magnitud no mayor que 2^53−1.')
        return int(exact)
    value = float(exact)
    if value == 0 and exact != 0:
        raise ValueError('Magnitud demasiado pequeña para la precisión numérica.')
    return value


def calculate(key):
    readings = []

    def read(label, **bounds):
        raw = input(label + ' (Enter cancela): ').strip()
        if not raw:
            raise EOFError
        value = number(raw, **bounds)
        readings.append(f'{label}: {raw}')
        return value

    formula, warning = CALCS[key][2], ''
    try:
        if key == 'ohm':
            v, r = read('Tensión [V]'), read('Resistencia [Ω]', positive=True)
            result = {'Corriente [A]': v / r, 'Potencia [W]': v * (v / r)}
        elif key == 'divider':
            v, r1, r2 = read('Vin [V]'), read('R1 [Ω]', positive=True), read('R2 [Ω]', positive=True)
            i = v / (r1 + r2)
            result = {'Vout sin carga [V]': i * r2, 'Corriente [A]': i, 'P R1 [W]': i * i * r1, 'P R2 [W]': i * i * r2}
        elif key == 'led':
            vs, vf, current = read('Fuente [V]', positive=True), read('Vf [V]', positive=True), read('Corriente [mA]', positive=True) / 1000
            if vs <= vf:
                raise ValueError('La fuente debe superar Vf para este modelo de LED con resistencia.')
            result = {'Resistencia teórica [Ω]': (vs - vf) / current, 'Disipación nominal [W]': (vs - vf) * current}
        elif key == 'rc':
            r, c = read('R [Ω]', positive=True), read('C [nF]', positive=True) * 1e-9
            tau = r * c
            result = {'Constante de tiempo [s]': tau, 'Corte [Hz]': 1 / (2 * math.pi * tau)}
        elif key == 'pwm':
            f, duty = read('Frecuencia [Hz]', positive=True), read('Duty [%]', low=0, high=100)
            result = {'Período [s]': 1 / f, 'Tiempo alto [s]': duty / 100 / f, 'Tiempo bajo [s]': (1 - duty / 100) / f}
        elif key == 'registers':
            raw = input('Cuatro bytes hex (ej. 3F 80 00 00; Enter cancela): ').strip()
            if not raw:
                raise EOFError
            compact = raw.replace(' ', '')
            if not re.fullmatch(r'[0-9a-fA-F]{8}', compact):
                raise ValueError('Se necesitan exactamente cuatro bytes hexadecimales.')
            data = bytes.fromhex(compact)
            readings.append('Bytes en orden de entrada: ' + data.hex(' ').upper())
            result = {'Binario ABCD': f'{int.from_bytes(data, "big"):032b}'}
            for label, b in [('ABCD', data), ('DCBA', data[::-1]), ('CDAB', data[2:] + data[:2]), ('BADC', bytes((data[1], data[0], data[3], data[2])))]:
                f = struct.unpack('>f', b)[0]
                result[label] = f'UINT32={int.from_bytes(b, "big")}; INT32={int.from_bytes(b, "big", signed=True)}; FLOAT32={f!r}'
                if not math.isfinite(f):
                    warning = 'IEEE-754 contiene NaN/Inf: no es un valor de ingeniería válido. Verificá tipo y endian.'
        elif key == 'rgb':
            r, g, b = [read(c + ' [0–255]', low=0, high=255, integer=True) for c in ('R', 'G', 'B')]
            rgb565 = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
            result = {'HEX RGB': f'#{r:02X}{g:02X}{b:02X}', 'RGB565': f'0x{rgb565:04X}', 'RGB565 decimal': rgb565}
        elif key == 'framebuffer':
            w, h = read('Ancho [px]', low=1, high=65536, integer=True), read('Alto [px]', low=1, high=65536, integer=True)
            bpp, buffers = read('Bits por píxel [1/8/16/24/32]', integer=True), read('Buffers', low=1, high=64, integer=True)
            if bpp not in (1, 8, 16, 24, 32):
                raise ValueError('Usá 1, 8, 16, 24 o 32 bits por píxel.')
            row = (w * bpp + 7) // 8
            total = row * h * buffers
            result = {'Bytes por fila': row, 'Bytes totales': total, 'MiB mínimos': total / 2**20}
        elif key == 'scaling':
            x, x0, x1 = read('Valor leído [unidad origen]'), read('Origen inicio'), read('Origen fin')
            y0, y1 = read('Ingeniería inicio [UE]'), read('Ingeniería fin [UE]')
            if x0 == x1:
                raise ValueError('Los extremos de origen deben ser distintos.')
            fraction = (x - x0) / (x1 - x0)
            result = {'Valor [UE]': y0 + fraction * (y1 - y0), 'Posición del rango [%]': fraction * 100}
            warning = 'FUERA DE RANGO: resultado extrapolado, sin recortar.' if not 0 <= fraction <= 1 else 'Dentro del rango; esto NO prueba que el sensor esté sano.'
        elif key == 'dosing':
            pulses, calibration = read('Pulsos', low=0, integer=True), read('Calibración [pulsos/L]', positive=True)
            target, density, tolerance = read('Objetivo [L]', positive=True), read('Densidad [kg/L]', positive=True), read('Tolerancia [%]', low=0, high=100)
            volume = pulses / calibration
            error = 100 * (volume - target) / target
            result = {'Volumen [L]': volume, 'Masa [kg]': volume * density, 'Error [L]': volume - target, 'Error [%]': error}
            # Inclusive boundary: account only for floating-point rounding, not sensor uncertainty.
            within = abs(error) <= tolerance or math.isclose(abs(error), tolerance, rel_tol=1e-12, abs_tol=0)
            warning = 'Dentro de la tolerancia ingresada.' if within else 'FUERA de la tolerancia ingresada.'
        elif key == 'repeatability':
            raw = input('Medidas [UE] separadas por ; (Enter cancela): ').strip()
            if not raw:
                raise EOFError
            if len(raw) > 6500 or not 2 <= len(raw.split(';')) <= 100:
                raise ValueError('Ingresá entre 2 y 100 medidas separadas por punto y coma.')
            values = [number(s) for s in raw.split(';')]
            readings.append('Medidas [UE]: ' + raw)
            mean, s = statistics.mean(values), statistics.stdev(values)
            result = {'Cantidad': len(values), 'Media [UE]': mean, 'Mínimo [UE]': min(values), 'Máximo [UE]': max(values), 'Desvío muestral [UE]': s}
            if mean:
                result['CV [%]'] = 100 * s / abs(mean)
            else:
                warning = 'CV no definido: media cero.'
        elif key == 'motion':
            rpm, ratio = read('rpm MOTOR'), read('Reducción [vueltas motor/vuelta salida]', positive=True)
            lead, counts = read('Avance [mm/vuelta salida]', positive=True), read('Cuentas/vuelta MOTOR', low=1, integer=True)
            result = {'rpm salida': rpm / ratio, 'Velocidad [mm/s]': rpm / ratio * lead / 60, 'Cuentas/mm': counts * ratio / lead}
        elif key == 'torque':
            power, rpm = read('Potencia mecánica en eje [kW]', low=0), read('Velocidad [rpm]', positive=True)
            result = {'Torque ideal [N·m]': power * 60000 / (2 * math.pi * rpm)}
        elif key == 'geometry':
            length, width, depth = [read(s + ' [m]', positive=True) for s in ('Largo', 'Ancho', 'Espesor')]
            factor = 1 + read('Desperdicio [%]', low=0, high=100) / 100
            area, volume = length * width, length * width * depth
            result = {'Superficie [m²]': area, 'Volumen [m³]': volume, 'Superficie estimada [m²]': area * factor, 'Volumen estimado [m³]': volume * factor}
        else:
            raise ValueError('Calculadora desconocida.')
    except ArithmeticError:
        raise ValueError('La operación excede la precisión numérica. Revisá magnitudes y unidades.') from None
    if any(not math.isfinite(v) for v in result.values() if isinstance(v, (int, float))):
        raise ValueError('Resultado fuera de la precisión numérica. Revisá magnitudes y unidades.')
    lines = [v if isinstance(v, str) else (str(v) if isinstance(v, int) else f'{v:.10g}') for v in result.values()]
    return '\n'.join(['Entradas:', *readings, '\nModelo: ' + formula, '\nResultados:',
                      *(f'{name}: {v}' for name, v in zip(result, lines)), warning])


def desktop_path(app_id):
    home = Path(os.environ.get('XDG_DATA_HOME', str(Path.home() / '.local/share')))
    dirs = [home, *(Path(p) for p in os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':') if p),
            home / 'flatpak/exports/share', Path('/var/lib/flatpak/exports/share')]
    return next((d / 'applications' / app_id for d in dirs if (d / 'applications' / app_id).is_file()), None)


def available(key):
    if key in APPS:
        return desktop_path(APPS[key][3]) is not None and shutil.which('gio', path=TOOL_PATH) is not None
    if key in GUIDES:
        return shutil.which(GUIDES[key][3][0], path=TOOL_PATH) is not None
    return key in CALCS or key == 'guide'


def action(key):
    if key in CALCS:
        print(calculate(key))
        return
    if key == 'guide':
        print(HELP)
        return
    if not available(key):
        raise ValueError('Falta el programa o su launcher; no se instala automáticamente.')
    if key in GUIDES:
        argv = GUIDES[key][3]
    elif key in APPS:
        argv = ['gio', 'launch', str(desktop_path(APPS[key][3]))]
    else:
        raise ValueError('Herramienta desconocida.')
    print('$ ' + shlex.join(argv), flush=True)
    env = {**os.environ, 'PATH': TOOL_PATH, 'PAGER': 'cat', 'MANPAGER': 'cat'}
    if key in GUIDES:
        env['QT_QPA_PLATFORM'] = 'offscreen'  # Qt option help must not need or open a display.
    result = subprocess.run(argv, timeout=30, env=env)
    if result.returncode:
        print(f'El programa terminó con código {result.returncode}.')


def main():
    parser = argparse.ArgumentParser(description='EQS Electrónica / Ingeniería: cálculos offline, aplicaciones y ayuda.')
    parser.add_argument('profile', choices=PROFILES)
    parser.add_argument('--list', action='store_true', help='Mostrar catálogo sin ejecutar herramientas.')
    args = parser.parse_args()
    title, keys = PROFILES[args.profile]
    tools = {k: TOOLS[k] for k in keys}
    if args.list:
        print(title)
        for k, (category, label, _) in tools.items():
            print(f'{k}\t{category}\t{label}')
        return 0
    if not sys.stdout.isatty():
        print('Abrí el toolbox desde Plasma o una terminal.', file=sys.stderr)
        return 2
    try:
        from eqs_hacking_ui import ToolboxApp
    except ImportError:
        print('Falta Textual o eqs_hacking_ui.py; ver port/shell/TOOLBOX.md.', file=sys.stderr)
        return 2
    modes = {k: ('OFFLINE', 'green') if k in CALCS else ('APP', 'green') if k in APPS else ('AYUDA', 'cyan') for k in keys}
    try:
        ToolboxApp(tools, GUIDES, action, title=title, boundary=BOUNDARY, modes=modes, available=available).run()
    except (KeyboardInterrupt, EOFError):
        pass
    return 0


if __name__ == '__main__':
    sys.exit(main())
